    function paginateTable(tableId, paginationId, defaultRowsPerPage, dropdownSelector = null) {
    let table = $(tableId);
    let tbody = table.find("tbody");
    let rows = tbody.find("tr");
    let paginationContainer = $(paginationId);
    let currentPage = 1;
    let maxVisiblePages = 5;

    let $dropdown = dropdownSelector ? $(dropdownSelector) : null;
    let rowsPerPage = $dropdown && $dropdown.length ? parseInt($dropdown.val()) : defaultRowsPerPage;

    function showPage(page) {
        rows.hide();
        let start = (page - 1) * rowsPerPage;
        let end = start + rowsPerPage;
        rows.slice(start, end).show();
        currentPage = page;
        updatePagination();
    }

    function updatePagination() {
        let totalPages = Math.ceil(rows.length / rowsPerPage);
        let paginationHTML = "";

        let prevDisabled = currentPage === 1 ? "disabled" : "";
        let nextDisabled = currentPage === totalPages ? "disabled" : "";

        paginationHTML += `
            <li class="page-item ${prevDisabled}">
                <a class="page-link" href="#" data-page="${currentPage - 1}">Previous</a>
            </li>`;

        if (totalPages <= maxVisiblePages) {
            for (let i = 1; i <= totalPages; i++) {
                let activeClass = currentPage === i ? "active" : "";
                paginationHTML += `
                    <li class="page-item ${activeClass}">
                        <a class="page-link" href="#" data-page="${i}">${i}</a>
                    </li>`;
            }
        } else {
            paginationHTML += `<li class="page-item ${currentPage === 1 ? "active" : ""}">
                <a class="page-link" href="#" data-page="1">1</a>
            </li>`;

            if (currentPage > 3) {
                paginationHTML += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }

            let startPage = Math.max(2, currentPage - 1);
            let endPage = Math.min(totalPages - 1, currentPage + 1);

            for (let i = startPage; i <= endPage; i++) {
                let activeClass = currentPage === i ? "active" : "";
                paginationHTML += `
                    <li class="page-item ${activeClass}">
                        <a class="page-link" href="#" data-page="${i}">${i}</a>
                    </li>`;
            }

            if (currentPage < totalPages - 2) {
                paginationHTML += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }

            paginationHTML += `<li class="page-item ${currentPage === totalPages ? "active" : ""}">
                <a class="page-link" href="#" data-page="${totalPages}">${totalPages}</a>
            </li>`;
        }

        paginationHTML += `
            <li class="page-item ${nextDisabled}">
                <a class="page-link" href="#" data-page="${currentPage + 1}">Next</a>
            </li>`;

        paginationContainer.html(paginationHTML);
    }

    paginationContainer.off("click").on("click", ".page-link", function (e) {
        e.preventDefault();
        let page = parseInt($(this).data("page"));
        if (!isNaN(page)) {
            showPage(page);
        }
    });

    // Bind local dropdown change (if provided)
    if ($dropdown && $dropdown.length > 0) {
        $dropdown.off("change").on("change", function () {
            rowsPerPage = parseInt($(this).val());
            currentPage = 1;
            showPage(currentPage);
        });
    }

    showPage(currentPage);
}


    function toggleInput(index, value) {
        let inputField = document.getElementById("score_value-" + index);
        if (inputField) {
            inputField.readOnly = value.toLowerCase() !==
            "default"; // input editable only when "Default" is selected
        }
    }

    function validateScore(input) {
        let value = input.value.trim();
        let prevValue = input.getAttribute("data-prev-value") || input.defaultValue;
        if (value === "") {
            return;
        }
        let numValue = parseInt(value, 10);
        if (isNaN(numValue) || numValue < 1) {
            alert("Score must be at least 1!");
            input.value = prevValue; // Restore previous valid value
        } else if (numValue > 100) {
            alert("Score cannot be more than 100!");
            input.value = prevValue; // Restore previous valid value
        } else {
            input.setAttribute("data-prev-value", numValue); // Store the valid input
        }
    }
    
    // blacklist 
    function blacklist(event) {
        if (event) event.preventDefault();
        const button = document.getElementById('blacklist-button');
        let type = document.getElementById("b-field").value;
        let value = document.getElementById("inputbvalue").value.trim();
        if (!value) {
            alert("Please enter a value");
            return;
        }
        // Email validation 
        if (type === "ue") {
            const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailPattern.test(value)) {
                showErrorNotification("Please enter a valid email address");
                return;
            }
        }
        button.textContent = "Updating...";
        button.disabled = true;
        $.ajax({
            url: "/blesta/admin/plugin/sensfrx/admin/saveBlacklist",
            method: "POST",
            contentType: "application/json",
            dataType: "json",
            data: JSON.stringify({
                checkKey: "saveBlacklist",
                type: type,
                value: value
            }),
            success: function(response) {
                if (response.success) {
                    button.textContent = "Updated ✅";
                    showSuccessNotification("Item Added successfully");
                    let container = document.getElementById(`blacklist-${type}`);
                    let parentDiv = document.querySelector(".page-box.policy-dets");
                    if (!container) {
                        let section = document.createElement("div");
                        section.classList.add("row", "policy-dets");
                        section.innerHTML = `
                            <div class="col-md-2">${type === "uID" ? "User ID:" : type === "ip" ? "IP:" : type === "ue" ? "Email:" : "Username:"}</div>
                            <div class="col-md-10 d-flex flex-wrap gap-2" id="blacklist-${type}"></div>
                        `;
                        parentDiv.appendChild(section);
                        container = document.getElementById(`blacklist-${type}`);
                    }
                    // Add the new item to the container
                    let newElement = document.createElement("div");
                    newElement.classList.add("items-block-ip");
                    newElement.innerHTML = `
                        <span>${value}</span>
                        <button class="close-btn" onclick="deleteBlacklistItem(this)" data-type="${type}" data-value="${value}">×</button>
                    `;
                    container.appendChild(newElement);
                    let noDataMsg = document.querySelector(".policy-dets p.text-center.mt-3");
                    if (noDataMsg) {
                        noDataMsg.remove();
                    }
                    document.getElementById("inputbvalue").value = "";
                    setTimeout(() => {
                        button.textContent = "Submit";
                        button.disabled = false;
                    }, 2000);
                } else {
                    button.textContent = "Error ❌";
                    console.error("Error Response:", response);
                    button.textContent = "Submit";
                    button.disabled = false;
                    let errorMessage = response.message?.message || "Error: Something went wrong!";
                    showModalErrorNotification(errorMessage);
                }
            },
            complete: function() {
                setTimeout(() => {
                    // Hide modal
                    $("#blacklistModal").modal("hide");
                    document.getElementById("blacklistModal").style.display = "none";
                    document.body.classList.remove("modal-open");
                    document.querySelector(".modal-backdrop")?.remove();
                }, 3000);
            },
            error: function(xhr, status, error) {
                button.textContent = "Error ❌";
                console.error("AJAX Error:", error);
                button.textContent = "Submit";
                button.disabled = false;
                showErrorNotification("Error: Something went wrong!");
            }
        });
    }

    function deleteBlacklistItem(button) {
        let itemElement = button.parentElement;
        let itemType = button.getAttribute("data-type");
        let itemValue = button.getAttribute("data-value");
        let container = itemElement.parentElement;
        if (!itemType || !itemValue) {
            console.error("Invalid data attributes on button.");
            return;
        }
        let confirmation = confirm(`Are you sure you want to delete "${itemValue}" from the blacklist?`);
        if (!confirmation) {
            return; // Exit if the user cancels
        }
        $.ajax({
            url: "/blesta/admin/plugin/sensfrx/admin/deleteBlacklist",
            method: "POST",
            contentType: "application/json",
            dataType: "json",
            data: JSON.stringify({
                checkKey: "deleteBlacklist",
                type: itemType,
                value: itemValue
            }),
            success: function(response) {
                if (response.success) {
                    itemElement.remove();
                    // If no more items are left, remove the entire row
                    if (container.children.length === 0) {
                        let rowElement = container.closest(".row");
                        if (rowElement) {
                            rowElement.remove();
                        }
                    }
                    showSuccessNotification(`"${itemValue}" removed successfully!`);
                } else {
                    console.error("Error removing item:", response);
                    showErrorNotification("Error: Something went wrong!");
                }
            },
            error: function(xhr, status, error) {
                console.error("AJAX Error:", error);
                showErrorNotification("Error: Something went wrong!");
            }
        });
    }

