    function saveNotificationsSetting() {
        var button = document.getElementById("save-notifications-setting");
        button.textContent = "Saving...";
        button.disabled = true;
        var emailInput = document.getElementById("emailInput22");
        var checkbox = document.getElementById("emailCheckboxx");
        var dropdown = document.getElementById("threshold");
        var email = emailInput.value.trim();
        var checkboxValue = checkbox.checked ? '1' : '0';
        var dropdownValue = dropdown.value;
        if (email === "") {
            alert("Please enter an email.");
            button.textContent = "Save Changes";
            button.disabled = false;
            return false;
        }
        var postData = {
            emailInput: email,
            threshold: dropdownValue,
            emailCheckbox: checkboxValue,
            checkKey: "saveNotificationsSetting",
        };
        fetch("/blesta/admin/plugin/sensfrx/admin/updateNotificationsSettings", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest"
                },
                body: JSON.stringify(postData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    emailInput.value = postData.emailInput;
                    checkbox.checked = postData.emailCheckbox === "1";
                    dropdown.value = postData.threshold;
                    button.textContent = "Updated ✅";
                    showSuccessNotification("Notification settings updated successfully");
                } else {
                    button.textContent = "Error ❌";
                    console.error("Error saving notification settings: ", data);
                    showErrorNotification("Error: Something went wrong!");
                }
            })
            .catch(error => {
                console.error("Error:", error);
                showErrorNotification("Error: Something went wrong!");
                button.textContent = "Error ❌";
            })
            .finally(() => {
                setTimeout(() => {
                    button.textContent = "Save Changes";
                    button.style.backgroundColor = "";
                    button.disabled = false;
                }, 3000);
            });
    }

    function refreshAlerts() {
        let alertsContainer = document.getElementById("alerts-container");
        alertsContainer.innerHTML = "<p>Loading latest alerts...</p>";
        $.ajax({
            url: "/blesta/admin/plugin/sensfrx/admin/getRecentAlerts",
            method: "GET",
            dataType: "json",
            success: function(response) {
                if (response.success && Array.isArray(response.alerts) && response.alerts.length >
                    0) {
                    var alertsHtml = "";
                    response.alerts.reverse().forEach(function(alert) {
                        var email = alert.ue || "Unknown Email";
                        var time = alert.et ?
                            new Date(alert.et).toLocaleString("en-GB", {
                                timeZone: "UTC",
                                day: "numeric",
                                month: "short",
                                year: "numeric",
                                hour: "2-digit",
                                minute: "2-digit",
                                hour12: true
                            }) : "Unknown Time";
                        var events = alert.events ? alert.events.split(',') : [
                            "Unknown Event"
                        ];
                        var eventTitle = events[0];
                        var description = events.length > 1 ? events.slice(1).join(", ") :
                            "No Description";
                        alertsHtml += `
                    <div class="recent-list">
                        <div class="recent-data">
                            <div class="recent-title">${escapeHtml(email)}</div>
                            <div class="recent-time">${escapeHtml(time)}</div>
                        </div>
                        <div class="recent-description">
                            ${escapeHtml(description)}
                        </div>
                    </div>`;
                    });
                    alertsContainer.innerHTML = alertsHtml;
                } else {
                    alertsContainer.innerHTML = "<p>No recent alerts available.</p>";
                }
            },
            error: function() {
                alertsContainer.innerHTML = "<p>Error fetching recent alerts.</p>";
            }
        });
    }

