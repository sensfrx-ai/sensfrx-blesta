        }
    });
    document.querySelector(".search-icon").addEventListener("click", searchPolicies);

    function searchPolicies() {
        const searchTerm = document.getElementById("searchInput").value.toLowerCase();
        const defaultPolicyTab = document.getElementById("defaut-policy");
        const advPolicyTab = document.getElementById("adv-policy");
        let table, paginationId;
        if (defaultPolicyTab.classList.contains("active") || defaultPolicyTab.classList.contains("show")) {
            table = document.getElementById("default-policy-table");
            paginationId = "#default-policy-pagination";
        } else if (advPolicyTab.classList.contains("active") || advPolicyTab.classList.contains("show")) {
            table = document.getElementById("adv-policy-table");
            paginationId = "#adv-policy-pagination";
        } else {
            return;
        }
        const rows = table.getElementsByTagName("tr");
        let filteredRows = [];
        for (let i = 1; i < rows.length; i++) {
            const policyNameCell = rows[i].getElementsByTagName("td")[1];
            if (policyNameCell) {
                const policyName = policyNameCell.textContent.toLowerCase();
                if (policyName.includes(searchTerm)) {
                    filteredRows.push(rows[i]);
                }
            }
        }
        for (let i = 1; i < rows.length; i++) {
            rows[i].style.display = "none";
        }
        filteredRows.forEach(row => row.style.display = "");
        // pagination dynamically based on search results
        paginateTable(filteredRows, paginationId, 10);
    }
    document.getElementById("searchInput").addEventListener("input", function() {
        document.querySelector(".clear-icon").style.display = this.value ? "block" : "none";
    });

    function clearSearch() {
        const input = document.getElementById("searchInput");
        input.value = "";
        document.querySelector(".clear-icon").style.display = "none";
        const defaultPolicyTab = document.getElementById("defaut-policy");
        const advPolicyTab = document.getElementById("adv-policy");
        let table, paginationId;
        if (defaultPolicyTab.classList.contains("active") || defaultPolicyTab.classList.contains("show")) {
            table = document.getElementById("default-policy-table");
            paginationId = "#default-policy-pagination";
        } else if (advPolicyTab.classList.contains("active") || advPolicyTab.classList.contains("show")) {
            table = document.getElementById("adv-policy-table");
            paginationId = "#adv-policy-pagination";
        } else {
            return;
        }
        const rows = table.getElementsByTagName("tr");
        for (let i = 1; i < rows.length; i++) { // Skip header row
            rows[i].style.display = "";
        }
        // Reappling pagination to ensure only 10 rows per page
        paginateTable(`#${table.id}`, paginationId, 10);
    }
    
    // registration review
    $(document).on("click", ".accept-reject-account", function(e) {
        e.preventDefault();
        let button = $(this);
        let row = button.closest("tr");
        let reg_id = button.data("reg_id");
        let action = button.data("action");
        let originalText = button.text();
        button.text(action === "approve" ? "Approving..." : "Rejecting...").prop("disabled", true);
        $.ajax({
            type: "POST",
            url: "/blesta/admin/plugin/sensfrx/admin/registration_review",
            dataType: "json",
            data: {
                "AjaxCheck": "approve/Reject",
                action: action,
                reg_id: reg_id
            },
            success: function(response) {
                if (response.success) {
                    button.text(action === "approve" ? "Approved ✅" : "Rejected ✅");
                    showSuccessNotification(action === "approve" ?
                        "Account approved successfully!" :
                        "Account rejected successfully!");
                    row.fadeOut(500, function() {
                        $(this).remove();
                    });
                    updateFraudCounts(); // Update fraud counts after removing row
                } else {
                    button.text("Failed ❌").prop("disabled", false);
                    showErrorNotification("Error: Something went wrong!");
                }
            },
            error: function(xhr, status, error) {
                console.error("AJAX Error:", error);
                button.text("Try Again").prop("disabled", false);
                showErrorNotification("Error: Something went wrong!");
            }
        });
    });
    
    // Bulk Approve/Reject
    $("#approveAccountBtn, #rejectAccountBtn").click(function(e) {
        e.preventDefault();
        let button = $(this);
        let originalText = button.text();
        let action = button.attr("id") === "approveAccountBtn" ? "approve" : "reject";
        let selectedIds = $(".SelectReg:checked").map(function() {
