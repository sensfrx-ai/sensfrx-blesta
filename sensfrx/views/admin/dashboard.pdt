<?php
if (count($assets["js"]) > 0) :
    foreach ($assets["js"] as $key => $js) :
        echo "<script src='$js'></script>";
    endforeach;
endif;
?>
<?php
if (count($assets["stylesheet"]) > 0) :
    foreach ($assets["stylesheet"] as $key => $css) :
        echo "<link rel='stylesheet' href='$css'>";
    endforeach;
endif;
?>
<?php
    if (!empty($successMessage)) {
    ?>
<div class="alert alert-success" role="alert"> <?php echo $successMessage; ?></div>
<?php
    }
    if (!empty($errorMessage)) { ?>
<div class="alert alert-danger" role="alert"> <?php echo $errorMessage; ?></div>
<?php
    return 0;
    }
    ?>
<?php if (!empty($error_messages) && is_array($error_messages)) { ?>
<!-- Notification Container -->
<div id="compact-error-notification-container"></div>
    <script>
        function showCompactErrorNotifi(errors) {
            if (!Array.isArray(errors)) {
                errors = [errors]; // Convert single error to an array
            }
            errors.forEach(function(message) {
                let notification = document.createElement("div");
                notification.className = "compact-notification fade-in";
                notification.innerHTML = `
                        <span class="compact-message">${message}</span>
                        <span class="compact-close-btn" onclick="this.parentElement.classList.add('fade-out'); setTimeout(() => this.parentElement.remove(), 300);">&times;</span>
                    `;
                document.getElementById("compact-error-notification-container").appendChild(notification);
                // Auto-hide notification after 5 seconds
                setTimeout(function() {
                    if (notification) {
                        notification.classList.add("fade-out");
                        setTimeout(() => notification.remove(), 300);
                    }
                }, 5000);
            });
        }
        document.addEventListener("DOMContentLoaded", function() {
            let errors = <?php echo json_encode($error_messages, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT |
                JSON_HEX_AMP); ?> ;
            showCompactErrorNotifi(errors);
        });
    </script>

    <style>
        /* Compact Notification Styling */
        #compact-error-notification-container {
            position: fixed;
            top: 100px;
            right: 20px;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .compact-notification {
            background-color: #ff4d4d;
            color: white;
            padding: 12px 18px;
            border-radius: 6px;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0px 3px 5px rgba(0, 0, 0, 0.2);
            animation: fadeIn 0.5s ease-out, fadeOut 0.5s 4.5s forwards;
        }

        .compact-close-btn {
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
            margin-left: auto;
            transition: color 0.3s;
        }

        .compact-close-btn:hover {
            color: #000;
        }

        /* Fade Animations */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateX(10px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @keyframes fadeOut {
            from {
                opacity: 1;
                transform: translateX(0);
            }

            to {
                opacity: 0;
                transform: translateX(10px);
            }
        }
    </style>
<?php } ?>

