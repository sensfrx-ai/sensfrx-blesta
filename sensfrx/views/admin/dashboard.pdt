        /* Space between input and search icon */
    }

    /* Search Input */
    .searchInput {
        width: 300px;
        padding: 10px;
        padding-right: 30px;
        /* Space for clear icon */
        border: 1px solid #0254ff;
        border-radius: 6px;
        font-size: 14px;
        outline: none;
    }

    /* Clear (✖) icon inside input */
    .clear-icon {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        font-size: 16px;
        color: #888;
        display: none;
        /* Initially hidden */
    }

    /* Show clear icon only when input has text */
    .searchInput:not(:placeholder-shown)+.clear-icon {
        display: block;
    }

    /* Search icon outside input */
    .search-icon {
        font-size: 18px;
        color: #0254ff;
        cursor: pointer;
        margin-left: -5px;
    }

