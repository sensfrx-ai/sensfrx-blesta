    function exportPolicies() {
        fetch("/blesta/admin/plugin/sensfrx/admin/exportPolicies")
            .then(response => {
                if (!response.ok) {
                    throw new Error("Failed to fetch export file");
                }
                return response.blob();
            })
            .then(blob => {
                let a = document.createElement("a");
                let url = window.URL.createObjectURL(blob);
                // Force HTTPS for the download URL
                if (window.location.protocol === "https:") {
                    url = url.replace("http://", "https://");
                }
                a.href = url;
                a.download = "policy.json";
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);
                showSuccessNotification("Policies exported successfully!");
            })
            .catch(error => {
                console.error("Export error:", error);
                showErrorNotification("Error: Something went wrong!");
            });
    }

    function toggleImportModal() {
        let modal = document.getElementById("importModal");
        modal.style.display = (modal.style.display === "block") ? "none" : "block";
    }
   
    const handleSubmitImport = async (event) => {
        event.preventDefault();
        const button = document.getElementById("import-submit");
        button.textContent = "Updating...";
        button.disabled = true;
        const fileInput = document.getElementById("fileInput");
        const file = fileInput.files[0];
        if (!file) {
            alert("Please select a file.");
            button.textContent = "Submit";
            button.disabled = false;
            return;
        }
        if (file.type !== "application/json") {
            alert("Please upload a valid JSON file.");
            button.textContent = "Submit";
            button.disabled = false;
            return;
        }
        const formData = new FormData();
        formData.append("jsonFile", file);
        try {
            const response = await fetch(
            "/blesta/admin/plugin/sensfrx/admin/saveImport", {
                method: "POST",
                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                },
                body: formData,
            });
            if (!response.ok) {
                throw new Error(`Error: ${response.status} ${response.statusText}`);
            }
            const data = await response.json();
            if (data.success) {
                button.textContent = "Updated ✅";
                setTimeout(() => {
                    button.textContent = "Submit";
                    button.disabled = false;
                }, 2000);
                showSuccessNotification("Policy Imported successfully");
            } else {
                console.error("Error: ", data.message);
                button.textContent = "Submit";
                button.disabled = false;
                showErrorNotification("Error: Something went wrong!");
            }
        } catch (error) {
            console.error("Error uploading file:", error);
            button.textContent = "Submit";
            button.disabled = false;
            showErrorNotification("Error: Something went wrong!");
        } finally {
            setTimeout(() => {
                const modalElement = document.getElementById("importModal");
                if (modalElement) {
                    modalElement.style.display = "none";
                    modalElement.classList.remove("show");
                    document.body.classList.remove("modal-open");
                    document.querySelector(".modal-backdrop")?.remove();
                }
            }, 3000);
        }
    };
    
    // search functionality
    document.getElementById("searchInput").addEventListener("keyup", function(event) {
