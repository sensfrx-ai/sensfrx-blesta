<script src="https://cdn.jsdelivr.net/npm/chart.js?ver=1" id="chart-js-js"></script>
<script src="https://cdn.ckeditor.com/ckeditor5/39.0.2/classic/ckeditor.js"></script>

<script>
    // passing the PHP variable `fraud_rate` to a JavaScript variable
    var fraudRate = <?php echo json_encode($fraud_rate); ?> ;
    $(document).ready(function() {
        var activeTab = $('.sub-tab-button.active').attr('href'); // active tab on page load
        var dataType = 'trans'; // Default to 'trans' for transaction tab
        // Defining currentPage globally (default to page 1)
        var currentPage = 1;
        var totalPages = 1;
        var recordsPerPage = parseInt($('#recordsPerPage').val()) || 10;
        //// edit email function ////
        let modalEditor; // global reference
        $('#policyeditEmail').on('shown.bs.modal', function() {
            // Destroying editor if already exists
            if (modalEditor) {
                modalEditor.destroy().then(() => {
                    createEditor(); // Recreate it
                });
            } else {
                createEditor();
            }
        });

        function createEditor() {
            ClassicEditor
                .create(document.querySelector('#modal_email_message'), {
                    toolbar: ['heading', 'bold', 'italic', 'link', 'bulletedList', 'numberedList',
                        'insertTable', 'undo', 'redo'
                    ],
                })
                .then(editor => {
                    modalEditor = editor;
                })
                .catch(error => console.error(error));
        }
        
        const emailVariableMap = {
            "Login Medium Severity Email Template": {
                "{$client_name}": "Displays the full name of the client.",
                "{$default_brand_name}": "Displays the default Business Name.",
                "{$device_name}": "Displays the full name of the device being used by the client.",
                "{$ip_address}": "Displays the IP address of the client.",
                "{$location}": "Displays the geographical location of the client.",
                "{$date}": "Displays the Date related to the action.",
                "{$time}": "Displays the time related to the action (e.g., login attempt time).",
            },
            "Login High Severity Email Template": {
                "{$client_full_name}": "Displays the full name of the client.",
                "{$default_brand_name}": "Displays the default Business Name.",
