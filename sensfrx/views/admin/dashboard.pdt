    // get fraud-reviews
    function loadFraudReviewData() {
        var selectedDateFilter = window.fraudReviewSelectedFilter;
        var activeTab = $('[data-group="fraud-review"] .sub-tab-button.active').attr('href');
        var fraudType = activeTab === "#btntran-fraud" ? "trans" : "reg";
        if (!fraudType) {
            fraudType = "trans";
        }
        let targetSelector = fraudType === "trans" ? '#transactionFraud-container' : '#registrationFraud-container';
        let tableSelector = fraudType === "trans" ? '#transactionReviewTable tbody' : '#registrationReviewTable tbody';
        $.ajax({
            url: "/blesta/admin/plugin/sensfrx/admin/fraud_review",
            type: "POST",
            data: {
                AjaxCheck: "displayFraudReview",
                "date-dropdown-fraud-review": selectedDateFilter,
                dataType: fraudType
            },
            dataType: "json",
            beforeSend: function() {
                $('.loader-placeholder').remove();
                showGlobalLoader(targetSelector);
                // Hide table while loading
                $(tableSelector).hide();
                $('.pagination-block').hide();
            },
            success: function(response) {
                if (response.status === "success") {
                    if (Array.isArray(response.fraud_review_transaction) && response
                        .fraud_review_transaction.length > 0) { populateTransactionTable(response.fraud_review_transaction);
                        paginateTable("#transactionReviewTable", "#transactionReviewPagination",10);
                        updateFraudCounts();
                    } else {
                        populateTransactionTable(response.fraud_review_transaction);
                    }
                    if (Array.isArray(response.fraud_review_registration) && response
                        .fraud_review_registration.length > 0) { populateRegistrationTable(response.fraud_review_registration);
                        paginateTable("#registrationReviewTable", "#registrationReviewPagination",10);
                        updateFraudCounts();
                    } else {
                        populateRegistrationTable(response.fraud_review_registration);
                    }
                    $(tableSelector).fadeIn();
                    $('.pagination-block').fadeIn();
                } else {
                    console.error("⚠️ Failed to fetch data. Please try again.");
                    showErrorNotification("Error: Something went wrong!");
                }
            },
            complete: function() {
                hideGlobalLoader(targetSelector); // Hides the loader after loading
                $(tableSelector).fadeIn();
            },
            error: function() {
                console.error("Error in AJAX request.");
                showErrorNotification("Error: Something went wrong!");
            }
        });
    }
    
    // fraud review tables 
    function populateTransactionTable(data) {
        var tbody = $("#transactionReviewTable tbody");
        tbody.empty(); // Clear old data
        if (!data || data.length === 0) {
            tbody.append('<tr><td colspan="9" class="text-center">No data available</td></tr>');
            return;
        }
        $.each(data, function(index, item) {
            var row = `
            <tr>
                <td><input type="checkbox" class="SelectTrans" name="Select_transId@@${escapeHtml(item.transaction_id)}" value="${escapeHtml(item.transaction_id)}"></td>
                <td>${escapeHtml(item.user_id)}</td>
                <td>${escapeHtml(item.email)}</td>
                <td>${escapeHtml(item.order_id)}</td>
                <td class="text-center"><span class="as-risk-scoreO">${escapeHtml(item.transaction_score)}</span></td>
                <td>${escapeHtml(item.ip)}</td>
                <td>${escapeHtml(formatDateTime(item.event_time))}</td>
                <td><a href="${escapeHtml(safeHref(item.link))}" target="_blank">View Detail</a></td>
                <td>
                    <button class="btn btn-success accept-reject-order" data-trans_id="${escapeHtml(item.transaction_id)}" data-action="approve">Approve</button>
                    <button class="btn btn-danger accept-reject-order" data-trans_id="${escapeHtml(item.transaction_id)}" data-action="reject">Reject</button>
                </td>
            </tr>`;
            tbody.append(row);
        });
    }
    
    // Registration Table
    function populateRegistrationTable(data) {
        var tbody = $("#registrationReviewTable tbody");
        if (tbody.length === 0) {
            console.error("❌ tbody not found! Check if #registrationReviewTable exists.");
            return;
        }
        tbody.empty(); // Clear old data
        if (!data || data.length === 0) {
            tbody.append('<tr><td colspan="9" class="text-center">No data available</td></tr>');
            return;
        }
        $.each(data, function(index, item) {
            var row = `
            <tr>
                <td><input type="checkbox" class="SelectReg" name="Select_regId@@${escapeHtml(item.registration_id)}" value="${escapeHtml(item.registration_id)}"></td>
                <td>${escapeHtml(item.username)}</td>
                <td>${escapeHtml(item.email)}</td>
                <td class="text-center"><span class="as-risk-scoreO">${escapeHtml(item.registration_score)}</span></td>
                <td>${escapeHtml(item.ip)}</td>
                <td>${escapeHtml(formatDateTime(item.event_time))}</td>
                <td><a href="${escapeHtml(safeHref(item.link))}" target="_blank">View Detail</a></td>
                <td>
                    <button class="btn btn-success accept-reject-account" data-reg_id="${escapeHtml(item.registration_id)}" data-action="approve">Approve</button>
                    <button class="btn btn-danger accept-reject-account" data-reg_id="${escapeHtml(item.registration_id)}" data-action="reject">Reject</button>
                </td>
            </tr>`;
            tbody.append(row);
        });
        $("#registrationReviewTable").hide().show(0);
    }

    function formatDateTime(dateString) {
        var date = new Date(dateString);
        return date.toLocaleDateString('en-GB') + " " + date.toLocaleTimeString('en-GB');
    }

    function updateFraudCounts() {
        $.ajax({
            type: "GET",
            url: "/blesta/admin/plugin/sensfrx/admin/getFraudCounts",
            dataType: "json",
            success: function(response) {
                if (response.success) {
                    let transactionCount = response.transactionCount || 0;
                    let registrationCount = response.registrationCount || 0;
                    let totalFraudCount = transactionCount + registrationCount;
                    $("#transactionFraudCount").text(transactionCount);
                    $("#registrationFraudCount").text(registrationCount);
                    $("#totalFraudCount").text(totalFraudCount);
                } else {
                    console.error("Error updating fraud counts:", response);
                    showErrorNotification("Error: Something went wrong!");
                }
            },
            error: function(xhr, status, error) {
                console.error("Failed to update fraud counts:", error);
                showErrorNotification("Error: Something went wrong!");
            }
        });
    }


</script>