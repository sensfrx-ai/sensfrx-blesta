    // Activity logs Table
    function loadActivityLogs() {
        $.ajax({
            url: '/blesta/admin/plugin/sensfrx/admin/activityLogs', 
            type: 'GET',
            dataType: 'json',
            beforeSend: function() {
                $('.loader-placeholder').remove();
                showGlobalLoader('#activity-container');
                // Hide table while loading
                $('#activityLogsTable tbody').hide();
                $('.pagination-block').hide();
            },
            success: function (response) {
                populateActivityTable(response);
                // paginateTable("#activityLogsTable", "#activity-pagination", 10);
            },
            complete: function() {
                hideGlobalLoader('#activity-container'); // Hides the loader after loading
                $('#activityLogsTable tbody').fadeIn();
                setTimeout(() => {
                    paginateTable("#activityLogsTable", "#activity-pagination", 10, "#activity-containr #recordsPerPage");
                }, 0);
            },
            error: function () {
                console.error("Failed to load activity data.");
            }
        });
    }

    function escapeHtml(value) {
        return String(value === null || value === undefined ? "" : value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");
    }

    // Only http(s) links may reach an href; anything else (javascript:, data:, ...) becomes '#'
    function safeHref(value) {
        var href = String(value === null || value === undefined ? "" : value);
        try {
            var url = new URL(href, window.location.href);
            return (href !== "" && (url.protocol === "https:" || url.protocol === "http:")) ? href : "#";
        } catch (e) {
            return "#";
        }
    }

    function populateActivityTable(data) {
        var tbody = $("#activityLogsTable tbody");
        if (tbody.length === 0) {
            console.error("❌ tbody not found! Check if #activityLogsTable exists.");
            return;
        }
        tbody.empty(); // Clearing old data
        if (!data || data.length === 0) {
            tbody.append('<tr><td colspan="9" class="text-center">No data available</td></tr>');
            return;
        }
        const userTimeZone = Intl.DateTimeFormat().resolvedOptions().timeZone; // Getting user's local timezone

        $.each(data, function(index, activity) {
            if (!activity.created_at) return; // Safety check

            // Fixing the created_at field
            var fixedDateStr = activity.created_at.replace(' ', 'T') + 'Z';
            var localTime = new Date(fixedDateStr).toLocaleString('en-US', { timeZone: userTimeZone });

            // Updating time inside the sensfrx_log1 message
            let updatedLog1 = activity.sensfrx_log1;
            const dateTimeRegex = /\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}/; // Matching date-time inside text

            const match = activity.sensfrx_log1.match(dateTimeRegex);
            if (match) {
                let originalDateStr = match[0];
                let fixedOriginalDateStr = originalDateStr.replace(' ', 'T') + 'Z';
                let localDateTimeInsideLog = new Date(fixedOriginalDateStr).toLocaleString('en-US', { timeZone: userTimeZone });

                updatedLog1 = activity.sensfrx_log1.replace(originalDateStr, localDateTimeInsideLog);
            }

            var row = `
            <tr>
                <td>${index + 1}</td>
                <td>${escapeHtml(activity.sensfrx_log_type)}</td>
                <td>${escapeHtml(updatedLog1)}</td>
                <td>${escapeHtml(localTime)}</td>
            </tr>`;
            tbody.append(row);
        });
        $("#activityLogsTable").hide().show(0);
    }

    document.getElementById("exportCsvBtn").addEventListener("click", function (e) {
        e.preventDefault();

        try {
            const table = document.getElementById("activityLogsTable");
            if (!table) throw new Error("Activity table not found");

            const rows = table.querySelectorAll("tr");
            if (rows.length === 0) throw new Error("No data available to export");

            let csvContent = "";

            rows.forEach((row) => {
                let rowData = [];
                row.querySelectorAll("td, th").forEach((cell) => {
                    let text = cell.textContent.trim().replace(/"/g, '""');
                    rowData.push(`"${text}"`);
                });
                csvContent += rowData.join(",") + "\r\n";
            });

            const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
            const url = URL.createObjectURL(blob);

            const link = document.createElement("a");
            link.setAttribute("href", url);
            link.setAttribute("download", "activity_logs.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            showSuccessNotification("Activity logs exported successfully!");
        } catch (error) {
            showErrorNotification(`Export failed: ${error.message}`);
        }
    });

    // search activity logs
    document.getElementById("searchInputActivity").addEventListener("keyup", function(event) {
        if (event.key === "Enter" || event.type === "keyup") {
            searchActivityLogs();
        }
    });
    document.querySelector(".search-icon-activityLogs").addEventListener("click", searchActivityLogs);

    function searchActivityLogs() {
        const searchTerm = document.getElementById("searchInputActivity").value.trim().toLowerCase();
        const table = document.getElementById("activityLogsTable");
        const rows = Array.from(table.getElementsByTagName("tr")).slice(1); // Skip header row
        let filteredRows = [];
        for (let i = 0; i < rows.length; i++) {
            const activity = rows[i].getElementsByTagName("td")[1]?.textContent.trim().toLowerCase() || "";
            const email = rows[i].getElementsByTagName("td")[2]?.textContent.trim().toLowerCase() || "";
            if (activity.startsWith(searchTerm) || email.includes(searchTerm)) {
                filteredRows.push(rows[i]);
            }
        }
        rows.forEach(row => row.style.display = "none"); // Hide all rows first
        paginateSearchResults($(filteredRows), "#activity-pagination", 10);
    }
    
    document.getElementById("searchInputActivity").addEventListener("input", function() {
        document.querySelector(".clear-icon-activityLogs").style.display = this.value ? "block" :
            "none";
    });
    document.querySelector(".clear-icon-activityLogs").addEventListener("click", clearActivityLogs);

    function clearActivityLogs() {
        const input = document.getElementById("searchInputActivity");
        input.value = "";
        document.querySelector(".clear-icon-activityLogs").style.display = "none";
        const table = document.getElementById("activityLogsTable");
        const rows = Array.from(table.getElementsByTagName("tr")).slice(1);
        rows.forEach(row => row.style.display = "");
        // Passing actual row elements to the pagination function
        paginateSearchResults($(rows), "#activity-pagination", 10);
    }

    function showEmailErrorNotification(message) {
        let openModal = $(".modal.show"); // Selects the modal that is currently visible
        if (openModal.length === 0) {
            console.error("No open modal found to display the notification.");
            return;
        }
        let notificationHTML = `
            <div class="alert alert-danger err-notification d-flex align-items-center justify-content-between mb-3" role="alert">
                <span class="message">${message}</span>
                <span class="as-close-btn" style="cursor: pointer; font-weight: bold;">&times;</span>
            </div>
        `;
        // Appending notification just before the Save button
        openModal.find("#saveEmailBtn").before(notificationHTML);
        openModal.find(".as-close-btn").on("click", function() {
            $(this).closest(".err-notification").remove();
        });
    }

    function showErrorNotification(message) {
        let notificationHTML = `
            <div class="notification">
                <span class="message">${message}</span>
                <span class="as-close-btn">&times;</span>
            </div>
        `;
        $(".notification-container").append(notificationHTML);
        setTimeout(function() {
            $(".notification").first().fadeOut(300, function() {
                $(this).remove();
            });
        }, 10000);
    }
    
    // Close notification when clicking close button
    $(document).off("click", ".as-close-btn").on("click", ".as-close-btn", function() {
        $(this).closest(".notification").fadeOut(300, function() {
            $(this).remove();
        });
    });

    function showSuccessNotification(message) {
        let notificationHTML = `
            <div class="notification success">
                <span class="message">${message}</span>
                <span class="as-close-btn">&times;</span>
            </div>
        `;

        $(".notification-container").append(notificationHTML);
        setTimeout(function() {
            $(".notification.success").first().fadeOut(300, function() {
                $(this).remove();
            });
        }, 5000);
    }

    function showModalErrorNotification(message) {
        let openModal = $(".modal.show"); // Selects the modal that is currently visible
        if (openModal.length === 0) {
            console.error("No open modal found to display the notification.");
            return;
        }
        let notificationHTML = `
            <div class="notification">
                <span class="message">${message}</span>
                <span class="as-close-btn">&times;</span>
            </div>
        `;
        openModal.find(".modal-body").prepend(notificationHTML);
        setTimeout(function() {
            openModal.find(".modal-body .notification").first().fadeOut(300, function() {
                $(this).remove();
            });
        }, 5000);
    }
    
    // all fraud review button 
    let selectedAction = null;
    let transactionId = null;
    let registrationId = null;
    let reviewType = null;

    // Handle click on any Review button
    $(document).on("click", ".app-btnO", function() {
        let id = $(this).data("id");
        reviewType = $(this).data("type"); // Get type (transaction, registration, ato)
        if (!id) {
            console.error("ID is undefined or null!");
            return;
        }
        transactionId = reviewType === "transaction" ? id : null;
        registrationId = reviewType === "registration" ? id : null;
        atoId = reviewType === "ato" ? id : null;
        if (reviewType === "registration") {
            $("#approveFraudReg, #rejectFraudReg").attr("data-reg_id", registrationId);
        } else if (reviewType === "transaction") {
            $("#approveFraudTrans, #rejectFraudTrans").attr("data-trans_id", transactionId);
        }
        $("#approveFraudTrans, #rejectFraudTrans, #approveFraudReg, #rejectFraudReg, #approveFraudAto, #rejectFraudAto").removeClass("btn-primary").addClass("btn-light");
    });

    // Handle Approve/Reject button clicks
    $(document).on("click", "#approveFraudTrans, #rejectFraudTrans, #approveFraudReg, #rejectFraudReg, #approveFraudAto, #rejectFraudAto",
        function(e) {
            e.preventDefault();
            selectedAction = $(this).data("action");
            if (reviewType === "transaction") {
                transactionId = $(this).attr("data-trans_id");
            } else if (reviewType === "registration") {
                registrationId = $(this).attr("data-reg_id");
            }
            $("#approveFraudTrans, #rejectFraudTrans, #approveFraudReg, #rejectFraudReg, #approveFraudAto, #rejectFraudAto").removeClass("btn-primary").addClass("btn-light");
            $(this).removeClass("btn-light").addClass("btn-primary");
        });

    // Handle Confirm button click
    $(document).on("click", "#confirm-btn-trans, #confirm-btn-reg, #confirm-btn-ato", function(e) {
        e.preventDefault();
        if (!selectedAction) {
            alert("Please select Approve or Reject before confirming.");
            return;
        }
        let button = $(this);
        button.text("Updating...").prop("disabled", true);
        let apiUrl = "";
        let requestData = {
            "AjaxCheck": "approve/Reject",
            action: selectedAction
        };
        if (reviewType === "transaction") {
            apiUrl = "/blesta/admin/plugin/sensfrx/admin/transaction_review";
            requestData.trans_id = transactionId;
            if (!transactionId) {
                alert("No transaction selected!");
                return;
            }
        } else if (reviewType === "registration") {
            apiUrl = "/blesta/admin/plugin/sensfrx/admin/registration_review";
            requestData.reg_id = registrationId;
            if (!registrationId) {
                alert("No registration selected!");
                return;
            }
        }
        $.ajax({
            url: apiUrl,
            type: "POST",
            dataType: "json",
            data: requestData,
            success: function(response) {
                if (response.success) {
                    button.text("Updated ✅").prop("disabled", true);
                    let targetButton = $(
                        `.app-btnO[data-id="${transactionId || registrationId || atoId}"][data-type="${reviewType}"]`
                        );
                    if (targetButton.length > 0) {
                        if (selectedAction === "approve") {
                            targetButton.replaceWith(
                                '<span class="app-btnA">Approved</span>');
                        } else if (selectedAction === "reject") {
                            targetButton.replaceWith(
                            '<span class="app-btnD">Denied</span>');
                        }
                    }
                    // Hiding modal after a short delay
                    setTimeout(() => {
                        $(`#${reviewType}ReviewModal`).modal("hide");
                        button.text("Confirm").prop("disabled", false);
                    }, 1000);
                } else {
                    button.text("Failed ❌").prop("disabled", false);
                    console.error("Error:", response);
                    showErrorNotification("Error: Something went wrong!");
                }
            },
            error: function(xhr, status, error) {
                console.error("AJAX Error:", error);
                showErrorNotification("Error: Something went wrong!");
            }
        });
    });

    function updateTransactionTable(fraudTransaction) {
        var baseUrl = window.location.origin;
        $('#transactions-table tbody').empty();
        if (Array.isArray(fraudTransaction) && fraudTransaction.length > 0) { 
            fraudTransaction.forEach(function(transaction) {
            let osImageName = transaction.os ? transaction.os.toLowerCase() : 'window';
            let osImageMap = {
                'windows': 'icon-window',
                'apple': 'icon-apple',
            };
            // default to 'icon-window' for unknown
            let osImage = osImageMap[osImageName] || 'icon-window';
            let riskScore = transaction.risk_score || 0; // Default to 0 if undefined
            let riskClass = (riskScore < 60) ? 'as-risk-scoreA' :
                (riskScore <= 90) ? 'as-risk-scoreO' :
                'as-risk-scoreD';
            var row = '<tr>';
            // Constructing the row content dynamically from transaction data
            row += '<td>' + (transaction.user_id || '-') + '</td>';
            row += '<td>' + (transaction.email || '-') + '</td>';
            row += '<td>' + (transaction.order_id || '-') + '</td>';
            row += '<td style="text-align: center;"><span class="' + riskClass + '">' + riskScore +
                '</span></td>';
            row += '<td>' +
                '<div class="as-platform">' +
                '<img src="' + baseUrl + '/blesta/plugins/sensfrx/assets/images/' + osImage +
                '.png" alt="Logo" class="platform-img" />' +
                '<span>' + (transaction.os || 'Unknown') + '</span>' +
                '</div>' +
                '</td>';
            row += '<td>' + (transaction.location || '-') + '</td>';
            row += '<td>' + (transaction.ip || '-') + '</td>';
            row += '<td>' + (transaction.event_time ? formatDate(transaction.event_time) : '-') +
                '</td>';
            row += '<td><a href="' + (transaction.link || '#') +
                '" target="_blank">View Detail</a></td>';
            row += '<td>' + (transaction.status === 'allow' ?
                '<span class="app-btnA">Approved</span>' : (transaction.status === 'deny' ?
                    '<span class="app-btnD">Denied</span>' : (transaction.status ===
                        'challenge' ? '<button class="app-btnO" data-id="' + transaction
                        .transaction_id +
                        '" data-type="transaction" data-toggle="modal" data-target="#transactionReviewModal">Review</button>' :
                        '<span class="app-btnUnknown">Unknown Status</span>'))) + '</td>';
            row += '</tr>';
            $('#transactions-table tbody').append(row);
        });
        } else {
            var row = '<tr><td colspan="10">No fraud transactions available.</td></tr>';
            $('#transactions-table tbody').append(row);
        }
    }

    function formatDate(dateString) {
        var date = new Date(dateString);
        if (isNaN(date)) return 'Invalid Date';
        return date.toLocaleString('en-US', {
            month: 'numeric',
            day: 'numeric',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: true // 12-hour format with AM/PM
        });
    }

    function showGlobalLoader(targetSelector = null) {
        let loader = $('#dashboardLoader');
        let target = targetSelector ? $(targetSelector) : null;
        if (target && target.length > 0) {
            if (target.css('position') === 'static') {
                target.css('position', 'relative');
            }
            if (target.is('table')) {
                let tbody = target.find('tbody');
                if (tbody.length > 0) {
                    tbody.hide();
                    if (!tbody.find('.loader-placeholder').length) {
                        tbody.append(
                            '<tr class="loader-placeholder"><td colspan="100%" style="text-align:center;"><div class="spinner"></div></td></tr>'
                            );
                    }
                }
            } else if (target.find('.stat-value').length > 0) {
                // If target contains .stat-value, hide only the text 
                let statValue = target.find('.stat-value');
                let detailsTitle = target.find('.dasb-details-tit');
                statValue.css('visibility', 'hidden');
                detailsTitle.css('visibility', 'hidden');
                if (!target.find('.loader-placeholder').length) {
                    target.css('position', 'relative');
                    target.append(`
                <div class="loader-placeholder" style="
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    width: 100%;
                    height: 50px;
                ">
                    <div class="spinner"></div>
                </div>
            `);
                }
            } else {
                if (!target.find('.loader-placeholder').length) {
                    target.append(
                        '<div class="loader-placeholder" style="display:flex; justify-content:center; align-items:center; height:100px;"><div class="spinner"></div></div>'
                        );
                }
            }
            loader.removeClass("loader-overlay").addClass("section-loader").appendTo(target).show();
        } else {
            console.warn(`⚠️ Target selector "${targetSelector}" not found. Using full-screen loader.`);
            loader.removeClass("section-loader").addClass("loader-overlay").appendTo('body').show();
        }
    }

    function hideGlobalLoader(targetSelector = null) {
        let loader = $('#dashboardLoader');
        let target = targetSelector ? $(targetSelector) : null;
        if (target && target.length > 0) {
            if (target.is('table')) {
                // If target is a table, remove loader row and show tbody
                let tbody = target.find('tbody');
                tbody.find('.loader-placeholder').remove(); // Remove loader row
                tbody.show();
            } else if (target.find('.stat-value').length > 0) {
                // If target contains .stat-value, show the text again
                let statValue = target.find('.stat-value');
                let detailsTitle = target.find('.dasb-details-tit');
                statValue.css('visibility', 'visible');
                detailsTitle.css('visibility', 'visible');
            }
            target.find('.loader-placeholder').remove();
            loader.hide().appendTo('body');
        } else {
            loader.hide().appendTo('body');
        }
    }

