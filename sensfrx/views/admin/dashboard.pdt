                    showErrorNotification("Error: Something went wrong!");
                }
            },
            error: function(xhr, status, error) {
                console.error("AJAX Error:", error);
                button.text(originalText).prop("disabled", false);
                showErrorNotification("Error: Something went wrong!");
            },
            complete: function() {
                button.prop("disabled", false);
            }
        });
    });
    
