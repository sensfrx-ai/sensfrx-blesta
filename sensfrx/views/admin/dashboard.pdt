        // fetching data based on the selected tab and filter value     
        function fetchFilteredData(page = 1) {
            var dataType = window.activeDataType || '';
            var selectedValueTrans = window.selectedFilterValue || '';
            var tableSelector = '';
            if (dataType === 'trans') {
                tableSelector = '#transactions-table-body';
                targetSelector = '#transactions-container';
            } else if (dataType === 'regs') {
                tableSelector = '#registrations-table-body';
                targetSelector = '#registrations-container';
            } else if (dataType === 'ato') {
                tableSelector = '#ato-table-body';
                targetSelector = '#ato-container';
            } else if (dataType === '') {
                tableSelector = '#transactions-table-body';
                targetSelector = '#transactions-container';
            }
            $.ajax({
                url: '',
                type: 'POST',
                data: {
                    'AjaxCheck': 'fetchFraudTransactions',
                    'date-dropdown-fraud-trans': selectedValueTrans,
                    'dataType': dataType,
                    'page': page,
                    'limit': recordsPerPage
                },
                dataType: "json",
                beforeSend: function() {
                    $('.loader-placeholder').remove();
                    showGlobalLoader(targetSelector);
                    // Hiding table while loading
                    $(tableSelector).hide();
                    $('.pagination-block').hide();
                },
                success: function(response) {
                    totalPages = Math.ceil(response.data.total_records / recordsPerPage);
                    if (response.status === "fail") {
                        console.error("API Error:", response.message);
                        return;
                    }
                    let totalPagesTrans = Math.ceil(response.data.total_records_trans /
                        recordsPerPage);
                    let totalPagesRegs = Math.ceil(response.data.total_records_regs /
                        recordsPerPage);
                    let totalPagesAto = Math.ceil(response.data.total_records_ato /
                        recordsPerPage);
                    updateTransactionTable(response.data.trans_list);
                    paginateTable("#transactions-table", "#trans-pagination",recordsPerPage);
                    updateRegistrationTable(response.data.reg_list);
                    paginateTable("#registrations-table", "#regs-pagination",recordsPerPage);
                    updateAtoTable(response.data.ato_list);
                    paginateTable("#ato-table", "#ato-pagination", recordsPerPage);
                    // Ensure table body is shown after loading
                    $(tableSelector).fadeIn();
                    $('.pagination-block').fadeIn();
                },
                error: function(xhr, status, error) {
                    console.error('AJAX Error: ', error);
                    showErrorNotification("Error: Something went wrong!");
                },
                complete: function() {
                    hideGlobalLoader(targetSelector);
                }
            });
        }
        
        //pagination for policies
        paginateTable("#default-policy-table", "#default-policy-pagination", 10);
        paginateTable("#adv-policy-table", "#adv-policy-pagination", 10);
        
        // hide search on black-whitelist
