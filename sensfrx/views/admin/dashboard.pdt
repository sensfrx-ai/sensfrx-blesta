                                    // Defining available filters based on the plan
                                    $filters = [
                                        'Free' => ['filter-7' => 'Last 7 Days'],
                                        'Pro' => ['filter-7' => 'Last 7 Days', 'filter-15' => 'Last 15 Days'],
                                        'Growth' => ['filter-7' => 'Last 7 Days', 'filter-15' => 'Last 15 Days', 'filter-30' => 'Last 30 Days'],
                                        'Business' => ['filter-7' => 'Last 7 Days', 'filter-15' => 'Last 15 Days', 'filter-30' => 'Last 30 Days', 'filter-60' => 'Last 60 Days'],
                                        'Enterprise' => ['filter-7' => 'Last 7 Days', 'filter-15' => 'Last 15 Days', 'filter-30' => 'Last 30 Days', 'filter-60' => 'Last 60 Days', 'filter-120' => 'Last 120 Days'],
                                        'Lifetime Access to Tier 1' => ['filter-7' => 'Last 7 Days', 'filter-15' => 'Last 15 Days'],
                                        'Lifetime Access to Tier 2' => ['filter-7' => 'Last 7 Days', 'filter-15' => 'Last 15 Days', 'filter-30' => 'Last 30 Days'],
                                        'Lifetime Access to Tier 3' => ['filter-7' => 'Last 7 Days', 'filter-15' => 'Last 15 Days', 'filter-30' => 'Last 30 Days', 'filter-60' => 'Last 60 Days']
                                    ];

                                    // Fetching filters based on the current plan
                                    $availableFilters = $filters[$currentPlan] ?? ['filter-7' => 'Last 7 Days']; // Default to All plan filters

                                    // Generate dropdown options dynamically
                                    foreach ($availableFilters as $value => $label) {
                                        $selected = ($selected_value == $value) ? 'selected' : '';
                                        echo "<option value='$value' $selected>$label</option>";
                                    }
                                    ?>
                                </select>
                            </form>
                        </div>
                    </div>
