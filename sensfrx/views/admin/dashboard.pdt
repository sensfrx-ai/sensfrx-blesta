    function formatMinusValue(value, selector) {
        const element = document.querySelector(selector);
        if (isNaN(value) || value === null || value === undefined) {
            updateElementClass(element, "decline", false);
            return "00.00%";
        }
        const numericValue = parseFloat(value);
        const isNegative = numericValue < 0;
        updateElementClass(element, "decline", isNegative);
        const formattedValue = `${isNegative ? "-" : "+"}${Math.abs(numericValue).toFixed(2)}%`;
        return formattedValue;
    }

    function updateElementClass(element, className, shouldAdd) {
        if (!element) return;
        if (shouldAdd) {
            element.classList.add(className);
        } else {
            element.classList.remove(className);
        }
    }
    
    // AJAX request to get the Property ID and Secret Key
    fetch('/blesta/admin/plugin/sensfrx/admin/getPropertyData', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                key: 'sensfrx_propertyId_secretKey_get'
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.status === 'success') {
                const propertyId = data.propertyId;
                const secretKey = data.secretKey;
                const domain = data.domain;
                const propertyIdField = document.getElementById('sensfrx_property_id');
                const secretKeyField = document.getElementById('sensfrx_secret_id');
                const domainField = document.getElementById('sensfrx_domain');
                if (propertyIdField) {
                    propertyIdField.value = propertyId;
                }
                if (secretKeyField) {
                    secretKeyField.value = secretKey;
                }
                if (domainField) {
                    domainField.value = domain;
                }
            } else {
                console.error('Error:', data.error);
                showErrorNotification("Error: Something went wrong!");
            }
        })
        .catch(error => {
            console.error('Fetch error:', error);
            showErrorNotification("Error: Something went wrong!");
        });

    function sensfrx_pid_skey_saveChanges() {
        const propertyId = document.getElementById('sensfrx_property_id').value;
        const secretKey = document.getElementById('sensfrx_secret_id').value;
        const domain = document.getElementById('sensfrx_domain').value;
        if (!propertyId || !secretKey) {
            alert("Please fill in both Property ID and Secret Key.");
            return;
        }
        const button = document.querySelector('.btn-propertysave');
        button.textContent = "Updating...";
        const data = {
            propertyId: propertyId,
            secretKey: secretKey,
            domain: domain,
            key: 'sensfrx_propertyId_secretKey_set'
        };
        fetch('/blesta/admin/plugin/sensfrx/admin/updatePropertyData', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(data)
            })
            .then(response => response.text())
            .then(text => {
                try {
                    return JSON.parse(text);
                } catch (error) {
                    throw new Error("Invalid JSON response from server");
                }
            })
            .then(data => {
                if (data.status === 'success') {
                    if (data.api_response.status == 'success') {
                        button.textContent = "Updated ✅";
                        showSuccessNotification("Updated Successfully");
                    } else if (data.api_response.status == 'error') {
                        showErrorNotification(`Error: ${data.api_response.message}`);
                        setTimeout(() => {
                            window.location.reload();
                        }, 2000);
                    }
                } else {
                    button.textContent = "Error ❌";
                    console.error('Error saving changes: ', data);
                    showErrorNotification("Error: Something went wrong!");
                }
            })
            .catch(error => {
                button.textContent = "Error ❌";
                console.error('Error:', error);
                showErrorNotification("Error: Something went wrong!");
            })
            .finally(() => {
                setTimeout(() => {
                    button.textContent = "Save Changes";
                }, 3000);
            });
    }

    function saveAccountSecurityPolicy() {
        const button = document.getElementById('save-acc-secu');
        button.textContent = "Updating...";
        button.disabled = true;
        const checkKey = 'saveAccountSecurityPolicy';
        let postData = {
            checkKey: checkKey,
            shadow_mode: document.getElementById('shadow_mode') ? (document.getElementById('shadow_mode')
                .checked ? "on" : "off") : "off"
        };
        document.querySelectorAll('#accout-security-policy .form-check-input').forEach((checkbox) => {
            postData[checkbox.id] = checkbox.checked ? "on" : "off";
        });
        fetch("/blesta/admin/plugin/sensfrx/admin/updatePolicies", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest"
                },
                body: JSON.stringify(postData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    button.textContent = "Updated ✅";
                    showSuccessNotification("Policies Updated Successfully");
                } else {
                    button.textContent = "Error ❌";
                    console.error("Error saving account security changes: ", data);
                    showErrorNotification("Error: Something went wrong!");
                }
            })
            .catch(error => {
                console.error("Error:", error);
                showErrorNotification("Error: Something went wrong!");
            })
            .finally(() => {
                setTimeout(() => {
                    button.textContent = "Save Changes";
                    button.style.backgroundColor = "";
                    button.disabled = false;
                }, 3000);
            });
    }

