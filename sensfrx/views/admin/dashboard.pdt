        $('.open-email-modal').on('click', function() {
            const title = $(this).data('title');
            const subject = $(this).data('subject');
            const message = $(this).data('message');
            const ajaxcheck = $(this).data('ajaxcheck');
            // Cleaning up old alerts if any
            $('#policyeditEmail .alert-danger').remove();
            $('#modal_email_title').text(title);
            $('#modal_email_subject').val(subject);
            $('#modal_email_message').val(message);
            // Storing AjaxCheck on the form element for later use
            $('#modal_email_form').data('ajaxcheck', ajaxcheck);
            // Set message only if editor is already ready
            if (modalEditor) {
                modalEditor.setData(message);
            } else {
                $('#modal_email_message').val(message); // fallback before editor loads
            }
            // Show dynamic available variables
            const vars = emailVariableMap[title];
            let html = '<p><strong>Available Variables:</strong></p>';
            if (vars) {
                for (let [key, desc] of Object.entries(vars)) {
                    html += `<p><code>${key}</code>: ${desc}</p>`;
                }
            } else {
                html += `<p><em>No predefined variables available.</em></p>`;
            }
            $('#modal_email_variables').html(html);
        });
        
        $('#modal_email_form').on('submit', function(e) {
            e.preventDefault();
            const button = document.getElementById("saveEmailBtn");
            button.textContent = "Updating...";
            button.disabled = true;
            const ajaxCheck = $('#modal_email_form').data("ajaxcheck");
            const emailTitle = $('#modal_email_title').text().trim();
            const emailSubject = $('#modal_email_subject').val();
            let emailMessage = modalEditor ? modalEditor.getData() : $('#modal_email_message').val();
            const sendTestEmail = $('#sendTestEmail').is(':checked') ? '1' : '0';
            if (!emailTitle || !emailSubject || !emailMessage) {
                showEmailErrorNotification("All fields are required.");
                button.textContent = "Save";
                button.disabled = false;
                return;
            }
            //  allowed variables
            const allowedVariables = Object.keys(emailVariableMap[emailTitle] || {});
            // Manual extraction of {$...} variables
            const extractedVariables = [];
            let tempMessage = emailMessage;
            while (tempMessage.indexOf('{$') !== -1) {
                const start = tempMessage.indexOf('{$');
                const end = tempMessage.indexOf('}', start);
                if (start !== -1 && end !== -1) {
                    const variable = tempMessage.substring(start, end + 1);
                    extractedVariables.push(variable);
                    tempMessage = tempMessage.substring(end + 1);
                } else {
                    break;
                }
            }
            // Filtering invalid or malformed variables
            let invalidVariables = extractedVariables.filter((variable) => {
                const name = variable.slice(2, -1); // remove {$ and }
                const isValidName = /^[a-zA-Z0-9_]+$/.test(name);
                const isAllowed = allowedVariables.includes(variable);
                return !isValidName || !isAllowed;
            });
            if (invalidVariables.length > 0) {
                showEmailErrorNotification("Invalid variables: " + invalidVariables.join(", "));
                button.textContent = "Save";
                button.disabled = false;
                return;
            }
            // Replacing variable before sending
            emailMessage = emailMessage.replace(/\{\$default_brand_name\}/g, '{$signature}');
            const data = {
                AjaxCheck: ajaxCheck
            };
            data[`${ajaxCheck}_title`] = emailTitle;
            data[`${ajaxCheck}_subject`] = emailSubject;
            data[`${ajaxCheck}_message`] = emailMessage;
            data[`${ajaxCheck}_sendTestEmail`] = sendTestEmail;
            $.ajax({
                type: "POST",
                url: "updateEmailTemplate",
                dataType: "json",
                data: data,
                success: function(response) {
                    if (response.result?.status === "success") {
                        button.textContent = "Updated ✅";
                        showSuccessNotification(response.result.message);
                        // Updating the 'Edit Email' button's data-* attributes
                        const $triggerBtn = $('.open-email-modal').filter(
                        function() {
                            return $(this).data('ajaxcheck') === ajaxCheck;
                        });
                        if ($triggerBtn.length > 0) {
                            $triggerBtn.data('title', emailTitle);
                            $triggerBtn.data('subject', emailSubject);
                            $triggerBtn.data('message', emailMessage.replace(/\{\$signature\}/g, '{$default_brand_name}')); // reverse the replacement
                        }
                    } else {
                        console.error(response.result?.message || "Something went wrong.");
                        button.textContent = "Error ❌";
                        showErrorNotification(response.result?.message ||"Something went wrong.");
                    }
                },
                error: function(xhr, status, error) {
                    console.error("AJAX Error:", status, error);
                    button.textContent = "Error ❌";
                    showErrorNotification("An error occurred while saving.");
                },
                complete: function() {
                    setTimeout(() => {
                        button.textContent = "Save";
                        button.disabled = false;
                        $('#policyeditEmail').modal('hide');
                    }, 2000);
                }
            });
        });
        
        $(document).on('change', '#recordsPerPage', function() {
            recordsPerPage = parseInt($(this).val()); // Get selected value
            currentPage = 1; // Reset to first page when changing records per page
            fetchFilteredData(currentPage); // Fetch new data with updated limit
        });

        // display dashboard stats 
        $('#date_dashboard').on('change', function() {
            var selectedValue = $(this).val();
            $.ajax({
                url: '',
                type: 'POST',
                data: {
                    'AjaxCheck': 'displayDashboad',
                    'date-dropdown': selectedValue
                },
                dataType: "json",
                beforeSend: function() {
                    // Hiding content before loader
                    $('.summary-box').each(function () {
                        $(this).find('.stat-row, .dasb-details-tit').hide();
                    });
                    showGlobalLoader("#stats-ato");
                    showGlobalLoader("#stats-trans");
                    showGlobalLoader("#stats-reg");
                    showGlobalLoader("#stats-bot");
                },
                success: function(response) {
                    if (response["status"] == "success") {
                        function formatValue(value) {
                            return isNaN(value) || value === null || value === undefined ? "No Data Available Yet" : value;
                        }
                        const updateStats = (prefix, data) => {
                            $(`#${prefix}_allowed`).text(formatValue(data["a_count"]));
                            $(`#${prefix}_review`).text(formatValue(data["c_count"]));
                            $(`#${prefix}_denied`).text(formatValue(data["d_count"]));
                        };

                        updateStats("ato", response["ato_info"]);
                        updateStats("trans", response["trans_info"]);
                        updateStats("reg", response["reg_info"]);
                        updateStats("bot", response["bot_info"]);
                    } else {
                        console.error('error in API Connection');
                        showErrorNotification("Error: Something went wrong!");
                    }
                },
                complete: function() {
                    // Showing content again after loading
                    $('.summary-box').each(function () {
                        $(this).find('.stat-row, .dasb-details-tit').show();
                    });
                    hideGlobalLoader("#stats-ato");
                    hideGlobalLoader("#stats-trans");
                    hideGlobalLoader("#stats-reg");
                    hideGlobalLoader("#stats-bot");
                },
                error: function(xhr, status, error) {
                    console.error('AJAX Error: ', error);
                    showErrorNotification("Error: Something went wrong!");
                }
            });
        });
        
