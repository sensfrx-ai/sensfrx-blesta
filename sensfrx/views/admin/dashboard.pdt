            var scoreInput = $row.find("#score_value-" + rowId);
            var scoreValue = scoreInput.val().trim();
            var actionSelect = $row.find("#action-" + rowId);
            var actionValue = actionSelect.val() ? actionSelect.val().trim().toLowerCase() : "default";
            var activeCheckbox = $row.find("#active-" + rowId);
            var activeStatus = activeCheckbox.prop("checked") ? "on" : "off";
            if (scoreValue !== "" && !isNaN(scoreValue) && scoreValue >= 1 && scoreValue <= 100 &&
                actionSelect.length) {
                updatedPolicies.score.push(scoreValue);
                updatedPolicies.action.push(actionValue);
                updatedPolicies.active.push(activeStatus);
                updatedPolicies.code.push(codeValue);
            }
        });
        if (updatedPolicies.score.length > 0) {
            $.ajax({
                url: "/blesta/admin/plugin/sensfrx/admin/updateDefaultPolicies",
                method: "POST",
                contentType: "application/json",
                dataType: "json",
                data: JSON.stringify({
                    checkKey: "saveDefaultPolicies",
                    rulesData: updatedPolicies,
                }),
                success: function(response) {
                    if (response.success) {
                        button.textContent = "Updated ✅";
                        showSuccessNotification("Default policies updated successfully");
                    } else {
                        button.textContent = "Error ❌";
                        console.error("Error Response:", response);
                        showErrorNotification("Error: Something went wrong!");
                    }
                },
                complete: function() {
                    setTimeout(() => {
                        button.textContent = "Save Changes";
                        button.style.backgroundColor = "";
                        button.disabled = false;
                    }, 3000);
                },
                error: function(xhr, status, error) {
                    button.textContent = "Error ❌";
                    console.error('AJAX Error: ', error);
                    showErrorNotification("Error: Something went wrong!");
                }
            });
        }
    }

