    function saveDefaultPolicies() {
        var button = document.getElementById("save-default-policies");
        button.textContent = "Updating...";
        button.disabled = true;
        var updatedPolicies = {
            score: [],
            action: [],
            active: [],
            code: []
        };
        $("#default-policy-table tbody tr").each(function() {
            var $row = $(this);
            var rowId = $row.data("row-id");
            var codeInput = $row.find("#code-" + rowId);
