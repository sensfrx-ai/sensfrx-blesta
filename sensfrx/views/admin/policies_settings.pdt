        $(".sensfrx_email_after_trans_challenge_btn-success").click(function(e) {
            e.preventDefault();
            var sensfrx_email_after_trans_challenge_title = $("#sensfrx_email_after_trans_challenge_title").text().trim();
            var sensfrx_email_after_trans_challenge_subject = $("#sensfrx_email_after_trans_challenge_subject").val();
            var sensfrx_email_after_trans_challenge_message = sensfrx_email_after_trans_challenge_message_editor.getData(); // Get CKEditor content
            var sendTestEmail = $("#sensfrx_email_after_trans_challenge_sendTestEmail").is(":checked") ? '1' : '0';

            if (sensfrx_email_after_trans_challenge_title == "" || sensfrx_email_after_trans_challenge_subject == "" || sensfrx_email_after_trans_challenge_message == "") {
                alert("All fields are required.");
                return;
            }
            sensfrx_email_after_trans_challenge_message = sensfrx_email_after_trans_challenge_message.replace('{$default_brand_name}', '{$signature}');
            // Defining allowed variables
            var allowedVariables = [
                "{$fullname}",
                "{$default_brand_name}",
                "{$signature}",
                "{$allow_url}",
                "{$deny_url}",
                "{$amount}",
                "{$date}",
            ];

            // Extracting variables manually (looking for {$variable_name} pattern)
            var extractedVariables = [];
            var tempMessage = sensfrx_email_after_trans_challenge_message;

            // Looping through and extracting every occurrence of {$variable_name} (with braces)
            while (tempMessage.indexOf('{$') !== -1) {
                var start = tempMessage.indexOf('{$');
                var end = tempMessage.indexOf('}', start);
                if (start !== -1 && end !== -1) {
                    var variable = tempMessage.substring(start, end + 1);
                    extractedVariables.push(variable);
                    tempMessage = tempMessage.substring(end + 1); // Continue to search the rest of the string
                }
            }

            // Finding invalid variables by comparing with the allowed list 
            var invalidVariables = extractedVariables.filter(function(variable) {
                // Check if the variable is in the allowedVariables list
                if (!allowedVariables.includes(variable)) {
                    return true;
                }

                // Valid variable names only contain letters, numbers, and underscores (no commas, periods, etc.)
                var name = variable.slice(2, -1); // Remove the "{$" and "}"
                var isValidName = /^[a-zA-Z0-9_]+$/.test(name); // Only letters, numbers, and underscores are allowed
                return !isValidName; // If invalid, return true
            });

            // Checking if the variable format is valid (it must not have extra braces or malformed structure)
            var malformedVariables = extractedVariables.filter(function(variable) {
                return variable.indexOf('{$') === -1 || variable.indexOf('}') === -1 || variable.length < 4;
            });

            invalidVariables = invalidVariables.concat(malformedVariables);

            if (invalidVariables.length > 0) {
                $("#emailAfterTransChallengeUpdateStatus")
                    .removeClass("alert-success")
                    .addClass("alert-danger")
                    .text("The following variables are invalid: " + invalidVariables.join(", "))
                    .show();
                return;  
            }

            jQuery.ajax({
                type: "POST",
                url: "updateEmailTemplate",
                dataType: "json",
                data: {
                    "AjaxCheck": "sensfrx_email_after_trans_challenge",
                    "sensfrx_email_after_trans_challenge_title": sensfrx_email_after_trans_challenge_title,
                    "sensfrx_email_after_trans_challenge_subject": sensfrx_email_after_trans_challenge_subject,
                    "sensfrx_email_after_trans_challenge_message": sensfrx_email_after_trans_challenge_message,
                    "sensfrx_email_after_trans_challenge_sendTestEmail": sendTestEmail,
                },              
                beforeSend: function () {
                    $("#emailReviewLoader").show();
                },          
                success: function(emailResponse) {
                    console.log("emailResponse:", emailResponse); 
                    // Check emailResponse status
                    if (emailResponse.result && emailResponse.result.status === "success") {
                        $("#emailAfterTransChallengeUpdateStatus")
                        .removeClass("alert-danger")
                        .addClass("alert-success")
                        .text(emailResponse.result.message)
                        .show();
                    } else if (emailResponse.result && emailResponse.result.status === "fail") {
                        $("#emailAfterTransChallengeUpdateStatus")
                        .removeClass("alert-success")
                        .addClass("alert-danger")
                        .text(emailResponse.result.message)
                        .show();
                    } else {
                        $("#emailAfterTransChallengeUpdateStatus")
                        .removeClass("alert-success")
                        .addClass("alert-danger")
                        .text("Unexpected emailResponse format.")
                        .show();
                    }
                    // Reload page after 3 seconds
                    setTimeout(() => location.reload(), 3000);
                },         
                error: function (xhr, status, error) {
                    console.error("AJAX Error:", {
                    status: status,
                    error: error,
                    emailResponseText: xhr.emailResponseText,
                    });
                    $("#emailAfterTransChallengeUpdateStatus")
