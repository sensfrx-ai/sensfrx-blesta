        //ato email update 
        $(".sensfrx_email_btn-success").click(function(e) {
            e.preventDefault();
            var sensfrx_email_title = $("#sensfrx_email_title").text().trim();
            var sensfrx_email_subject = $("#sensfrx_email_subject").val();
            var sensfrx_email_message = sensfrx_email_message_editor.getData(); // Get CKEditor content
            var sendTestEmail = $("#sensfrx_email_sendTestEmail").is(":checked") ? '1' : '0';

            if (sensfrx_email_title == "" || sensfrx_email_subject == "" || sensfrx_email_message == "") {
                alert("All fields are required.");
                return;
            }    

            sensfrx_email_message = sensfrx_email_message.replace('{$default_brand_name}', '{$signature}');

            // Defining allowed variables
            var allowedVariables = [
                "{$client_name}",
                "{$signature}",
                "{$default_brand_name}",
                "{$device_name}",
                "{$ip_address}",
                "{$location}",
                "{$date}",
                "{$time}",
            ];

            // Extracting variables manually (looking for {$variable_name} pattern)
            var extractedVariables = [];
            var tempMessage = sensfrx_email_message;

            // Looping through and extracting every occurrence of {$variable_name} (with braces)
            while (tempMessage.indexOf('{$') !== -1) {
                var start = tempMessage.indexOf('{$');
                var end = tempMessage.indexOf('}', start);
                if (start !== -1 && end !== -1) {
